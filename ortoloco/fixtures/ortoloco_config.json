[
  {
    "model": "juntagrico.subscriptioncategory",
    "pk": 1,
    "fields": {
      "name": "Schnupperabo",
      "description": "Komm ein 1/4-Jahr schnuppern! Du bekommst die Gemüsetasche, Obst, Öl und Getreide und bezahlst dafür 610 CHF und leistest 3 Einsätze.\r\n\r\nInhalt:\r\n- Gemüse (10x 1 Tasche/Woche)\r\n- Obst-Anteil\r\n- Sonnenblumenöl-Anteil\r\n- Getreide-Anteil",
      "sort_order": 1
    }
  },
  {
    "model": "juntagrico.subscriptioncategory",
    "pk": 3,
    "fields": {
      "name": "Vollabo",
      "description": "Vollabo mit Gemüse, Fleisch, Obst, Öl und Getreide. Das Getreide kann flexibel in Form von Mehl, Körnern oder Flocken bezogen werden. Bitte wähle unter den Varianten, ob du einen Teil des Getreides in verarbeiteter Form von Pasta und/oder Brot beziehen möchtest.\r\n\r\nInhalt:\r\n- Gemüse (1 Tasche/Woche)\r\n- Obst (1 Portion/Woche)\r\n- Sonnenblumenöl (je nach Ertrag)\r\n- Fleisch (2x7.5 kg/Jahr)\r\n- Getreide (ca. 32 kg/Jahr)",
      "sort_order": 3
    }
  },
  {
    "model": "juntagrico.subscriptioncategory",
